{
  "seed": 1337,
  "device": "mps",

  "data": {
    "pt_path": "./cache/",
    "num_workers": 0,
    "use_y_as_target": false,
    "reverse_time": false,
    "split_by_z": false,
    "z_index": 2,
    "z_tol": 0.0
  },

  "features": {
    "use_columns": [0, 1],
    "target_columns": [0, 1],
    "names": [
      "velocity_x",
      "velocity_y"
    ],
    "normalize": true,
    "normalization": {
      "normalization_mode": "minmax_11",
      "_comment_normalization_mode": "Options: 'zscore' for (x - mean) / std, 'minmax_11' for [-1,1]",
      "velocity_sigma_mode": "shared"
    },
    "reynolds_input": {
      "enabled": true,
      "mode": "log",
      "_comment_mode": "Options: 'log' -> log10(Re), 'nu' -> 1/Re"
    },
    "boundary_mask_input": {
      "enabled": false,
      "type": "cylinder",
      "feature_mode": "signed_distance",
      "_comment_feature_mode": "Options: 'mask', 'signed_distance', 'unsigned_distance', 'mask_signed_distance', 'mask_unsigned_distance'",
      "distance_scale": "band",
      "_comment_distance_scale": "Options: 'none', 'band', 'radius'. For signed/unsigned distance modes, divides distance by this scale.",
      "distance_clip": 3.0,
      "infer_from_data": false,
      "infer_band_scale": 1.5,
      "infer_min_nodes": 16,
      "center_xy": [0.0, 0.0],
      "radius": 0.5,
      "band": 0.08,
      "_comment": "Boundary geometry channels for the cylinder. In distance modes, signed/unsigned distance is computed from r-radius. If infer_from_data=true, center/radius/band are inferred from pos+edge_index."
    },
    "relative_geometry_input": {
      "enabled": true,
      "channels": ["domain_distances", "cylinder_signed_distance"],
      "_comment_channels": "domain_distances gives normalized distances to xmin/xmax/ymin/ymax; cylinder_signed_distance gives signed distance from the cylinder boundary.",
      "domain_bbox": [-5.0, 15.0, -5.0, 5.0],
      "_comment_domain_bbox": "Use null or 'auto' to infer [xmin,xmax,ymin,ymax] from each static mesh.",
      "domain_distance_clip": null,
      "cylinder_distance_scale": "radius",
      "_comment_cylinder_distance_scale": "Options: 'none', 'radius', 'band', or 'domain'.",
      "cylinder_distance_clip": 10.0,
      "center_xy": [0.0, 0.0],
      "radius": 0.5,
      "band": 0.08,
      "infer_from_data": false,
      "infer_band_scale": 1.5,
      "infer_min_nodes": 16
    },
    "include_pos": false,
    "pos_columns": [0, 1],

    "pos_normalization": {
      "enabled": false,
      "mode": "minmax_11",
      "_comment_mode": "Options: 'zscore' or 'minmax_11'; applied only to GNN input pos channels."
    }
  },

  "split": {
    "train": 0.8,
    "val": 0.1,
    "test": 0.1
  },

  "train": {
    "epochs": 200,
    "validation_every_epochs": 5,
    "batch_size": 1,
    "lr": 0.0005,
    "weight_decay": 0.0,
    "grad_clip": 1.0,
    "window_size": 5,
    "stride": 1,
    "autoregressive": true,
    "save_dir": "./runs_karman_basic/from_jinyoungs_files/no_physics/minmax_11-norm/with_reynolds/200ep/"
  },

  "model": {
    "type": "sageconv",
    "_comment_type": "Options: 'sageconv', 'meshgraphnet', 'fluxgraphnet'",
    "hidden": 128,
    "layers": 3,
    "dropout": 0.0,
    "activation": "relu",
    "activation_negative_slope": 0.01,
    "activation_elu_alpha": 1.0,
    "use_skip": false,
    "use_layernorm": false,
    "layernorm_eps": 1e-06,

    "_comment_fluxgraphnet": "Used when model.type='fluxgraphnet'. Edge fluxes are conservative on interior/cylinder graph edges; exterior domain sides use open-boundary source terms.",
    "_comment_predict_type": "Options for all model types: 'state' predicts x(t+1); 'delta' predicts normalized x(t+1)-x(t); 'rate' predicts the normalized time derivative and is integrated with dt/dt_ref.",
    "predict_type": "rate",
    "dt_ref": null,
    "flux_scale": 1.0,
    "use_dual_volume": true,
    "volume_floor": 1e-12,
    "use_open_boundary_source": true,
    "open_boundary_mode": "learned_source",
    "open_boundary_modes_by_side": {
      "left": "learned_source",
      "right": "learned_source",
      "bottom": "learned_source",
      "top": "learned_source"
    },
    "open_boundary_flux_scale": 0.05,
    "open_boundary_flux_outflow_only": true,
    "boundary_width": 0.02,
    "domain_bbox": [-5.0, 15.0, -5.0, 5.0],
    "cylinder_center_xy": [0.0, 0.0],
    "cylinder_radius": 0.5,
    "cylinder_boundary_width": 0.08,
    "velocity_channels": [0, 1]
  },

  "loss": {
    "use_huber": false,
    "huber_delta": 0.05
  },

  "physics": {
    "physics_backend": "dec",
    "parc_include_adv": false,
    "parc_include_diff": false,
    "advection_type": "scalar",
    "velocity_channels": [0, 1],
    "advection_scheme": "upwind",
    "euler_flux_scheme": "rusanov",
    "adv_weight": 1.0,
    "diff_weight": 1.0,
    "nu": 0.0,
    "parc_input_form": "rate",
    "parc_predict_type": "rate",
    "parc_detach_inputs": true,
    "parc_input_weighted": false,

    "mls_ops_device": "cpu",
    "mls_use_2hop_extension": true,
    "mls_use_neighbor_damping": true,
    "mls_damping_alpha": 0.5,
    "mls_poly_order": 2,
    "mls_min_neighbors": 6,
    "mls_cache_by_geometry": false,

    "rho_floor": 1e-6,
    "rho_eps": 1e-8,
    "u_clip": 1000.0
  }
}
