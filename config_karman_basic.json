{
  "seed": 1337,
  "device": "mps",

  "data": {
    "pt_path": "./cache/",
    "num_workers": 0,
    "use_y_as_target": false,
    "reverse_time": false,
    "split_by_z": false,
    "z_index": 2,
    "z_tol": 0.0
  },

  "features": {
    "use_columns": [0, 1],
    "target_columns": [0, 1],
    "names": [
      "velocity_x",
      "velocity_y"
    ],
    "normalize": true,
    "normalization": {
      "normalization_mode": "minmax_11",
      "_comment_normalization_mode": "Options: 'zscore' for (x - mean) / std, 'minmax_11' for [-1,1]",
      "velocity_sigma_mode": "shared"
    },
    "reynolds_input": {
      "enabled": true,
      "mode": "log",
      "_comment_mode": "Options: 'log' -> log10(Re), 'nu' -> 1/Re"
    },
    "include_pos": true,
    "pos_columns": [0, 1],

    "pos_normalization": {
      "enabled": true,
      "mode": "minmax_11",
      "_comment_mode": "Options: 'zscore' or 'minmax_11'; applied only to GNN input pos channels."
    }
  },

  "split": {
    "train": 0.8,
    "val": 0.1,
    "test": 0.1
  },

  "train": {
    "epochs": 5,
    "validation_every_epochs": 1,
    "batch_size": 1,
    "lr": 0.0005,
    "weight_decay": 0.0,
    "grad_clip": 1.0,
    "window_size": 5,
    "stride": 1,
    "autoregressive": true,
    "save_dir": "./runs_karman_basic/test"
  },

  "model": {
    "name": "FeatureNet",
    "hidden": 128,
    "layers": 3,
    "dropout": 0.1
  },

  "loss": {
    "use_huber": false,
    "huber_delta": 0.05
  },

  "physics": {
    "physics_backend": "dec",
    "parc_include_adv": true,
    "parc_include_diff": false,
    "advection_type": "scalar",
    "velocity_channels": [0, 1],
    "advection_scheme": "upwind",
    "euler_flux_scheme": "rusanov",
    "adv_weight": 1.0,
    "diff_weight": 1.0,
    "nu": 0.0,
    "parc_input_form": "rate",
    "parc_predict_type": "rate",
    "parc_detach_inputs": true,
    "parc_input_weighted": false,

    "mls_ops_device": "cpu",
    "mls_use_2hop_extension": true,
    "mls_use_neighbor_damping": true,
    "mls_damping_alpha": 0.5,
    "mls_poly_order": 2,
    "mls_min_neighbors": 6,
    "mls_cache_by_geometry": false,

    "rho_floor": 1e-6,
    "rho_eps": 1e-8,
    "u_clip": 1000.0
  }
}
